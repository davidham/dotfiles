# Machine-local shell config. Copy this file to
# ${XDG_CONFIG_HOME:-$HOME/.config}/shell-local.zsh and edit there.
# The real file is gitignored. Never commit secrets to the dotfiles repo.

# --- SSH key auto-load (uncomment if you want it) ---
# Loads your default SSH key into the macOS keychain at shell start so
# you do not have to enter the passphrase after every reboot.
# if [[ -o interactive ]] && [[ -f ~/.ssh/id_ed25519 ]]; then
#   ssh-add --apple-use-keychain ~/.ssh/id_ed25519 2>/dev/null
# fi

# --- Per-machine env vars ---
# export SOMETHING=value

# --- Per-machine secrets ---
# Never put plaintext secrets here. Prefer a secret manager.
#
# --- GitHub auth ---
# Just run `gh auth login` once (browser OAuth). gh stores the resulting
# credential in the OS keychain and reads it directly -- no env var and no
# secret-manager call needed at command time, so it works fine in
# non-interactive, scripted, and sandboxed shells.
#
# Do not wire GITHUB_TOKEN/GH_TOKEN up to a secret manager (e.g. 1Password's
# `op` CLI) called eagerly on every interactive shell. `op` needs a unix
# socket to the desktop app that a sandboxed shell (e.g. Claude Code) cannot
# reach, and the failure mode is not a clean error -- it hangs silently
# waiting on a Touch ID prompt the sandbox has no way to surface. Learned the
# hard way; cost real debugging time.
#
# Also: gh itself cannot run sandboxed on macOS. It fails TLS verification
# with "x509: OSStatus -26276" because the sandbox blocks securityd. This
# surfaces misleadingly as gh reporting "the token in keyring is invalid" --
# it is not an auth problem. Add "gh" and "gh *" to sandbox.excludedCommands
# in ~/.claude/settings.json.
